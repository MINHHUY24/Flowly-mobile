{
  "name": "flowly-mobile",
  "version": "1.0.0",
  "description": "Flowly Flutter mobile app with Express + Supabase API",
  "main": "server/index.js",
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "nodemon --watch server --watch .env server/index.js",
    "dev:flutter": "cd mobile && flutter run",
    "dev:mobile": "concurrently -k -n SERVER,FLUTTER -c blue,green \"npm run dev:server\" \"npm run dev:flutter\"",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@supabase/supabase-js": "^2.105.1",
    "cors": "^2.8.6",
    "date-holidays": "^3.27.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.4"
  }
}
